# ============================================================
# Backend Environment Variables (.env.example)
# Copy this file to .env and fill with your REAL values
#
# USAGE:
#   cp .env.example .env
#   nano .env          ← fill in real values
# ============================================================

# --- Server Configuration ---
PORT=8080
HOST=0.0.0.0
ENV=development
GIN_MODE=release

# --- Database (Supabase PostgreSQL) ---
# Format: postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
# Use TRANSACTION pooler (port 6543), NOT session pooler (port 5432)
# Render commonly provides DATABASE_URL. DB_DSN is still supported for local/backward compatibility.
DATABASE_URL=
DB_DSN=postgresql://postgres.xxxx:your_password_here@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# --- JWT Configuration ---
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production
JWT_EXPIRE=24h

# --- PDDikti Student Verification ---
# Default provider template can be overridden. Use {nim} where the NIM should be inserted.
# Local Python (Flask) microservice that validates NIM against PDDikti:
PDDIKTI_VERIFY_URL=http://localhost:5001/validate-nim?nim={nim}
PDDIKTI_HEALTH_URL=http://localhost:5001/health
PDDIKTI_STARTUP_TIMEOUT_SECONDS=60
PDDIKTI_ALLOWED_INSTITUTIONS=SEKOLAH TINGGI TEKNOLOGI TERPADU NURUL FIKRI,Sekolah Tinggi Teknologi Terpadu Nurul Fikri,STT-NF,STT Nurul Fikri
PDDIKTI_TIMEOUT_MS=5000
PDDIKTI_VERIFICATION_SECRET=change_this_for_registration_tokens
# The Go backend auto-starts pddikti_service.py as a managed child process on `go run main.go`.
PDDIKTI_AUTOSTART=true
PDDIKTI_HEALTH_URL=http://localhost:5001/health
PDDIKTI_STARTUP_TIMEOUT_SECONDS=60
# PYTHON_BIN=python            # override the Python interpreter (py / python3) if not on PATH as `python`
# PDDIKTI_SCRIPT_PATH=../pddikti_service.py   # override path to the Flask service
# PDDIKTI_PIP_INSTALL=true     # set once to auto pip install -r requirements.txt before launch

# --- Upload Configuration ---
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=10485760

# --- Email Configuration (optional) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_PASSWORD=your_app_password
SMTP_FROM=NF Student HUB <no-reply@nurulfikri.ac.id>

# --- Email Verification ---
# When true, students must click the verification link before they can log in.
# Keep false in local dev unless SMTP above is configured.
EMAIL_VERIFICATION_REQUIRED=false
FRONTEND_URL=http://localhost:3000

# --- Pakasir Payment Configuration (optional) ---
PAKASIR_API_KEY=your_pakasir_api_key
PAKASIR_SLUG=nf-student-hub
# ⚠️ On VPS: change to https://e-learning-openclaw.vercel.app
APP_URL=http://localhost:3000
PAKASIR_BASE_URL=https://app.pakasir.com
# ⚠️ On VPS: change localhost to YOUR_VPS_IP
PAKASIR_WEBHOOK_URL=http://localhost:8080/api/webhook/pakasir

# --- QRIS Configuration (optional) ---
QRIS_FEE_PERCENTAGE=0.7
TRANSFER_FEE_PERCENTAGE=0.5
MINIMUM_PAYMENT=10000
MAXIMUM_PAYMENT=10000000
DEFAULT_UKT_AMOUNT=7000000

# --- OpenClaw Reminder System ---
OPENCLAW_BASE_URL=http://localhost:9090
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHANNEL_ID=@tugasreminder
OPENCLAW_CRON_SCHEDULE=0 * * * *

# --- Features ---
ENABLE_WEBSOCKET=true
ENABLE_CHAT=true
ENABLE_NOTIFICATIONS=true

# --- Logging ---
LOG_LEVEL=info
LOG_FILE=./logs/app.log

# --- CORS ---
# Comma-separated list of extra allowed origins (in addition to localhost and Vercel)
# The backend ALWAYS allows: localhost, e-learning-openclaw.vercel.app, and LAN IPs
# Add any custom domains here if needed
ALLOWED_ORIGINS=https://e-learning-openclaw.vercel.app

# --- Internal API Key (for OpenClaw internal endpoints) ---
INTERNAL_API_KEY=your_internal_api_key_here
NAMA=E-Learning-OPENCLAW
